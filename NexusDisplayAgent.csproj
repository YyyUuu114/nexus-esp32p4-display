<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\nexus-display.ico</ApplicationIcon>
    <Version>2.1.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyName>Nexus Display</AssemblyName>
    <RootNamespace>NexusDisplay</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The pinned LibreHardwareMonitor .NET 10 Windows archive exposes
         System.IO.Ports analyzer metadata as Unix-only. The application and
         selected runtime assembly are Windows-specific and are validated on
         Windows 10/11, so this package metadata false positive is suppressed. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RepositoryUrl>https://github.com/YyyUuu114/nexus-esp32p4-display</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 YyyUuu114</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>vendor\NexusRuntime\LibreHardwareMonitorLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Ports">
      <HintPath>vendor\NexusRuntime\System.IO.Ports.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Management">
      <HintPath>vendor\NexusRuntime\System.Management.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- LibreHardwareMonitor's portable archive carries reference, Unix, and
       Windows assemblies with the same identity. ResolveAssemblyReference can
       otherwise select a platform implementation based on discovery order.
       Replace the copy-local entries after resolution so the published
       Windows application always embeds the two pinned Windows assemblies. -->
  <Target Name="SelectPinnedWindowsRuntime" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(Filename)%(Extension)' == 'System.IO.Ports.dll' Or '%(Filename)%(Extension)' == 'System.Management.dll'" />
      <ReferenceCopyLocalPaths Include="$(MSBuildProjectDirectory)\vendor\NexusRuntime\System.IO.Ports.dll">
        <DestinationSubDirectory></DestinationSubDirectory>
        <CopyLocal>true</CopyLocal>
      </ReferenceCopyLocalPaths>
      <ReferenceCopyLocalPaths Include="$(MSBuildProjectDirectory)\vendor\NexusRuntime\System.Management.dll">
        <DestinationSubDirectory></DestinationSubDirectory>
        <CopyLocal>true</CopyLocal>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>

  <Target Name="VerifyPinnedWindowsRuntime" AfterTargets="Build">
    <GetFileHash Files="$(TargetDir)System.IO.Ports.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="BuiltPortsHash" />
    </GetFileHash>
    <GetFileHash Files="$(TargetDir)System.Management.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="BuiltManagementHash" />
    </GetFileHash>
    <Error Condition="'%(BuiltPortsHash.FileHash)' != '331FF3528809BF54382461FDF0FBDFDCB6C221D770DA7C755EF531801A80554A'"
           Text="The build did not select the pinned Windows System.IO.Ports runtime." />
    <Error Condition="'%(BuiltManagementHash.FileHash)' != '01F9360D110863F810431C4D29ADA0FCA89F267343D030E98AA823EA4C0C0EBB'"
           Text="The build did not select the pinned Windows System.Management runtime." />
  </Target>

</Project>
