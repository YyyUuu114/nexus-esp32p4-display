{
  "schemaVersion": 1,
  "productVersion": {
    "format": "MAJOR.LINE.CHANNEL",
    "stableChannel": 0,
    "developmentChannels": [1, 2, 3, 4, 5, 6, 7, 8, 9],
    "stablePrecedesDevelopmentWithinLine": false,
    "stableIsFinalWithinLine": true
  },
  "wireProtocol": {
    "format": "WIRE_MAJOR.WIRE_REVISION",
    "frameMajorField": "v",
    "unknownFieldsMustBeIgnored": true,
    "optionalFieldsMayBeMissing": true,
    "majorMismatchIsCompatible": false
  },
  "updateClasses": {
    "single-endpoint": {
      "wireChange": "none",
      "peerUpdateRequired": false
    },
    "coordinated-additive": {
      "wireChange": "revision",
      "peerUpdateRequired": false
    },
    "coordinated-breaking": {
      "wireChange": "major",
      "peerUpdateRequired": true
    },
    "paired-baseline": {
      "wireChange": "baseline",
      "peerUpdateRequired": true
    }
  }
}
